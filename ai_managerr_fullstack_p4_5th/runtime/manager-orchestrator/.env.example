APP_NAME=manager-orchestrator
APP_ENV=local
SIMULATION_MODE=true
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_orchestrator
CORS_ORIGINS=http://localhost:5174
AGENT_CONFIG_PATH=/app/config/agents.yaml
DEFAULT_TIMEOUT_SECONDS=120
USE_ROUTER=true
ROUTER_BASE_URL=http://router:8080/v1
ROUTER_BEARER_TOKEN=
ROUTER_MODEL_NAME=router-auto
JOB_MODE=background
WORKER_POLL_INTERVAL_SECONDS=2
MAX_STEP_RETRY_COUNT=2
QUEUE_DEAD_LETTER_ATTEMPTS=6
ARTIFACT_DIR=/app/artifacts
RAG_ENABLED=true
RAG_PROVIDER=qdrant
RAG_TOP_K=6
RAG_TIMEOUT_SECONDS=15
VECTOR_STORE_ENABLED=true
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://qdrant:6333
VECTOR_STORE_API_KEY=
VECTOR_COLLECTION_PREFIX=agent_orchestrator
VECTOR_DIMENSION=256
VECTOR_CHUNK_SIZE=700
VECTOR_CHUNK_OVERLAP=120
VECTOR_INDEX_ARTIFACTS=true
VECTOR_ARTIFACT_TYPES=project-knowledge,step-output,tool-report,rag-context
VECTOR_EMBEDDING_PROVIDER=hash
VECTOR_EMBEDDING_BASE_URL=
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
BUILD_RUNNER_ENABLED=true
TEST_RUNNER_ENABLED=true
LINT_RUNNER_ENABLED=true
TYPE_RUNNER_ENABLED=true
SECURITY_RUNNER_ENABLED=true
TOOL_COMMAND_TIMEOUT_SECONDS=120
SCHEMA_VALIDATION_ENABLED=true
AUTH_ENABLED=true
AUTH_SESSION_HOURS=12
AUTH_SEED_USERS_ENABLED=true
AUTH_ADMIN_PASSWORD=admin1234!
AUTH_OPERATOR_PASSWORD=operator1234!
AUTH_REVIEWER_PASSWORD=reviewer1234!
AUTH_VIEWER_PASSWORD=viewer1234!
APPROVAL_ENABLED=true
APPROVAL_REQUIRED_PHASES=manager-merge
APPROVAL_DEFAULT_ROLE=reviewer
APPROVAL_POLICY=manager-merge=reviewer>admin
APPROVAL_AUTO_RESUME=true
APPROVAL_SLA_HOURS=24
APPROVAL_ALERT_BEFORE_MINUTES=60
APPROVAL_SLA_PHASE_HOURS=manager-merge=4
RETRY_BACKOFF_BASE_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120
RUN_STALE_AFTER_SECONDS=900
STEP_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALE_AFTER_SECONDS=30
EVENT_STREAM_POLL_INTERVAL_SECONDS=2

RUNNER_SANDBOX_MODE=local
RUNNER_SANDBOX_DOCKER_IMAGE=manager-orchestrator-runner-python:latest
RUNNER_SANDBOX_DOCKER_IMAGES=python=manager-orchestrator-runner-python:latest,node=manager-orchestrator-runner-node:latest,java-maven=manager-orchestrator-runner-java:latest,java-gradle=manager-orchestrator-runner-java:latest
RUNNER_SANDBOX_DOCKER_USER=65532:65532
RUNNER_SANDBOX_DOCKER_READ_ONLY=true
RUNNER_SANDBOX_DOCKER_MEMORY=1024m
RUNNER_SANDBOX_DOCKER_CPUS=1.0
RUNNER_SANDBOX_DOCKER_PIDS_LIMIT=256
RUNNER_SANDBOX_NETWORK_ENABLED=false
