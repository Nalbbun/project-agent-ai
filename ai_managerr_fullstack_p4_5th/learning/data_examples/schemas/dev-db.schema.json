{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-db.schema.json",
  "title": "Dev-DB Sample Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dev-db-\\d{6}$"
    },
    "role": {
      "const": "dev-db"
    },
    "lang": {
      "$ref": "common-defs.schema.json#/$defs/lang"
    },
    "domain": {
      "$ref": "common-defs.schema.json#/$defs/domain"
    },
    "difficulty": {
      "$ref": "common-defs.schema.json#/$defs/difficulty"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "constraints"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 2
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ddl",
        "indexes",
        "migration"
      ],
      "properties": {
        "ddl": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "indexes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "file"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "metadata": {
      "$ref": "common-defs.schema.json#/$defs/metadata"
    }
  }
}