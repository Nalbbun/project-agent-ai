{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secops.schema.json",
  "title": "SecOps Sample Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^secops-\\d{6}$"
    },
    "role": {
      "const": "secops"
    },
    "lang": {
      "$ref": "common-defs.schema.json#/$defs/lang"
    },
    "domain": {
      "$ref": "common-defs.schema.json#/$defs/domain"
    },
    "difficulty": {
      "$ref": "common-defs.schema.json#/$defs/difficulty"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dockerfile",
            "k8s_yaml",
            "ci_pipeline",
            "app_config"
          ],
          "properties": {
            "dockerfile": {
              "type": "string"
            },
            "k8s_yaml": {
              "type": "string"
            },
            "ci_pipeline": {
              "type": "string"
            },
            "app_config": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "hardening_actions",
        "priority_order"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "category",
              "issue",
              "recommendation"
            ],
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hardening_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "$ref": "common-defs.schema.json#/$defs/metadata"
    }
  }
}