{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.schema.json",
  "title": "PM Sample Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-\\d{6}$"
    },
    "role": {
      "const": "pm"
    },
    "lang": {
      "$ref": "common-defs.schema.json#/$defs/lang"
    },
    "domain": {
      "$ref": "common-defs.schema.json#/$defs/domain"
    },
    "difficulty": {
      "$ref": "common-defs.schema.json#/$defs/difficulty"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_request"
      ],
      "properties": {
        "user_request": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "functional_requirements",
        "non_functional_requirements",
        "questions",
        "out_of_scope",
        "acceptance_criteria"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 5
        },
        "functional_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_functional_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "$ref": "common-defs.schema.json#/$defs/metadata"
    }
  }
}