{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.schema.json",
  "title": "QA Sample Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^qa-\\d{6}$"
    },
    "role": {
      "const": "qa"
    },
    "lang": {
      "$ref": "common-defs.schema.json#/$defs/lang"
    },
    "domain": {
      "$ref": "common-defs.schema.json#/$defs/domain"
    },
    "difficulty": {
      "$ref": "common-defs.schema.json#/$defs/difficulty"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "code_summary"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_summary": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_cases",
        "boundary_cases",
        "regression_checklist"
      ],
      "properties": {
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "given",
              "when",
              "then"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "given": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "then": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "boundary_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regression_checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "$ref": "common-defs.schema.json#/$defs/metadata"
    }
  }
}