              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "path",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "database": {
          "type": "object",
