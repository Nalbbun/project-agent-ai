        "sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "architecture_style",
        "components",
        "apis",
        "database",
        "sequence",
        "adrs"
      ],
      "additionalProperties": false
