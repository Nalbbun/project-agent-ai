    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "$ref": "common-runtime.schema.json"
        }
      },
      "required": [
        "source",
        "version"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "additionalProperties": false,
