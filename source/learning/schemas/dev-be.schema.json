{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev BE Agent Training Sample",
  "type": "object",
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "version"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "role": {
      "const": "dev-be"
    },
    "lang": {
      "enum": [
        "ko",
        "en",
        "mixed"
      ]
    },
    "domain": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "design_context": {
          "type": "object"
        }
      },
      "required": [
        "task",
        "design_context"
      ],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "required": [
    "id",
    "role",
    "lang",
    "domain",
    "difficulty",
    "input",
    "output",
    "metadata"
  ],
  "additionalProperties": false
}