# Copy to .env before running docker compose.
HF_TOKEN=
VLLM_ROUTER_API_KEY=change-me
ROUTER_BEARER_TOKEN=

# Host ports
ROUTER_HOST_PORT=8080
VLLM_GENERAL_HOST_PORT=8000
VLLM_CODER_HOST_PORT=8001
VLLM_EXAONE_HOST_PORT=8002
OLLAMA_HOST_PORT=11434

# GPU / runtime
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Model storage roots on the host
MODEL_ROOT=/srv/llm
HF_CACHE_DIR=/srv/cache/huggingface
OLLAMA_DATA_DIR=/srv/ollama
LLAMACPP_ROOT=/opt/llama.cpp
BASE_MODEL_ROOT=/srv/llm/base
ADAPTER_ROOT=/srv/llm/adapters
MERGED_HF_ROOT=/srv/llm/merged/hf
GGUF_ROOT=/srv/llm/merged/ollama

# Optional tuning
VLLM_GENERAL_MAX_MODEL_LEN=8192
VLLM_CODER_MAX_MODEL_LEN=8192
VLLM_EXAONE_MAX_MODEL_LEN=8192
VLLM_GENERAL_GPU_MEM_UTIL=0.92
VLLM_CODER_GPU_MEM_UTIL=0.90
VLLM_EXAONE_GPU_MEM_UTIL=0.90
VLLM_GENERAL_MAX_LORAS=4
VLLM_CODER_MAX_LORAS=4
VLLM_EXAONE_MAX_LORAS=2
VLLM_GENERAL_MAX_LORA_RANK=64
VLLM_CODER_MAX_LORA_RANK=64
VLLM_EXAONE_MAX_LORA_RANK=64

# Ollama bootstrap roles
OLLAMA_ROLES=architect,dev-fe,dev-be,dev-db,qa,secops
DRY_RUN=0
